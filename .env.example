# Copy to .env and fill in. `make run` sources this file.

# --- Required: the bot will not boot without these ---------------------------

# From @BotFather.
TELEGRAM_BOT_TOKEN=

# Random string Telegram echoes back in the X-Telegram-Bot-Api-Secret-Token
# header on every webhook POST; requests that do not match are dropped.
# Generate once with: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Externally reachable base URL of this bot, no trailing slash. Used to
# register the webhook (${MEDIABOT_PUBLIC_URL}/webhook) and for the keep-alive
# self-ping. For local dev, use a tunnel (ngrok, cloudflared) — Telegram must
# be able to reach it, so localhost does not work.
MEDIABOT_PUBLIC_URL=

# Comma-separated allowlist of Telegram chat IDs. Required (empty = deny all).
# Group chat IDs are negative. For prod, sync from allowed_chat_ids.txt with
# `make sync-allowlist`. To find your ID, message the bot and check the logs
# for `msg received chat=...`.
MEDIABOT_ALLOWED_CHAT_IDS=

# --- Optional: defaults shown ------------------------------------------------

YTDLP_PATH=yt-dlp

# Netscape-format cookies.txt, for age- or region-restricted videos.
YTDLP_COOKIES_PATH=

# Defaults to $TMPDIR/mediabot.
MEDIABOT_TEMP_DIR=

MEDIABOT_MAX_CONCURRENT_DOWNLOADS=3

# Videos longer than this are rejected before the quality keyboard is shown.
# 0, unset, or invalid all fall back to 45 — there is no unlimited mode.
MEDIABOT_MAX_DURATION_MINUTES=45

# --- Deployment (only needed if you deploy this yourself) --------------------

# Fly app name. `fly.toml` carries no `app` key, so the Makefile deploy/logs/ssh
# targets read it from here and pass it to flyctl as `-a`.
FLY_APP=
